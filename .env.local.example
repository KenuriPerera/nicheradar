# YouTube Data API v3
# Get from: console.cloud.google.com
YOUTUBE_API_KEY=

# Supabase
# Get from: supabase.com → Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_PUBLISHABLE_KEY=

# Google Gemini AI
# Get from: aistudio.google.com
GEMINI_API_KEY=

# NewsAPI
# Get from: newsapi.org
NEWS_API_KEY=

# MongoDB Atlas
# Get from: mongodb.com/atlas → Connect → Drivers
MONGODB_URI=

# EmailJS (for health check alerts)
# Get from: emailjs.com
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_TO_EMAIL=
